{
  "name": "blackjack-troyano",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run --filter @blackjack/client build",
    "start": "bun server/src/index.ts",
    "db:reset": "bun scripts/db-reset.ts",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bun run --filter @blackjack/shared typecheck && bun run --filter @blackjack/server typecheck && bun run --filter @blackjack/client typecheck && tsc --project scripts/tsconfig.json",
    "empaquetar": "bun scripts/empaquetar.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "5.9.3"
  }
}
